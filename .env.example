# ---------------------------------------------------------------------------
# C64GameEngine - Docker configuration
# Copy this file to ".env" and adjust the values as needed.
# ---------------------------------------------------------------------------

# Port exposed on the host for the PRODUCTION stack (nginx)
APP_PORT=3000

# Port exposed on the host for the DEVELOPMENT stack (vite + HMR)
DEV_PORT=3001

# Hostname used by the browser to reach the HMR websocket.
# Use the IP of the machine when accessing the dev server from another device.
HMR_HOST=localhost

# Folder mounted inside the development container (default: the project folder).
# Change it only if the project lives somewhere else on the host.
DEV_MOUNT=.

# Comma separated list of hosts allowed to reach the vite dev server.
# "true" means "any host" (fine for local development).
ALLOWED_HOSTS=true

# Timezone used inside the containers
TZ=Europe/Rome
