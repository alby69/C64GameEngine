# syntax=docker/dockerfile:1
#
# C64GameEngine - Development image
# Vite dev server with hot reload (source code is bind-mounted by docker-compose)

FROM node:22-alpine

WORKDIR /app

ENV TZ=Europe/Rome \
    NODE_ENV=development \
    CHOKIDAR_USEPOLLING=true

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Rest of the project (bind-mounted at runtime by docker-compose)
COPY . .

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1

CMD ["npm", "run", "dev"]
